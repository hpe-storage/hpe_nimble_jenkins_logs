[2026-07-31T15:02:47.483Z]         /^[^ \t]+/ {
[2026-07-31T15:02:47.484Z]             # get offset of first = in $0
[2026-07-31T15:02:47.484Z]             eq_idx = index($0, "=")
[2026-07-31T15:02:47.484Z]             # extract attr & value from $0
[2026-07-31T15:02:47.484Z]             attr = substr($0, 1, eq_idx - 1)
[2026-07-31T15:02:47.484Z]             value = substr($0, eq_idx + 1)
[2026-07-31T15:02:47.484Z]             # only need to strip trailing whitespace from attr

[2026-08-04T23:06:18.974Z]             # cfg_sec_attr_name: keep the attr names in the same order as they appear in local.conf
[2026-08-04T23:06:18.974Z]             if (! (section, attr) in cfg_attr_count) {
[2026-08-04T23:06:18.974Z]                 if (section != last_section) {
[2026-08-04T23:06:18.974Z]                     cfg_section[section_count++] = section
[2026-08-04T23:06:18.974Z]                     last_section = section
[2026-08-04T23:06:18.974Z]                 }
[2026-08-04T23:06:18.975Z]                 attr_count = cfg_sec_attr_count[section_count - 1]++
[2026-08-04T23:06:18.975Z]                 cfg_sec_attr_name[section_count - 1, attr_count] = attr
[2026-08-04T23:06:18.975Z] 
[2026-08-04T23:06:18.975Z]                 cfg_attr[section, attr, 0] = value
[2026-08-04T23:06:18.975Z]                 cfg_attr_count[section, attr] = 1
[2026-08-04T23:06:18.975Z]             } else {
[2026-08-04T23:06:18.975Z]                 lno = cfg_attr_count[section, attr]++
[2026-08-04T23:06:18.975Z]                 cfg_attr[section, attr, lno] = value
[2026-08-04T23:06:18.975Z]             }
[2026-08-04T23:06:18.975Z]         }
[2026-08-04T23:06:18.975Z]         END {
[2026-08-04T23:06:18.975Z]             # Process each section in order
[2026-08-04T23:06:18.975Z]             for (sno = 0; sno < section_count; sno++) {
[2026-08-04T23:06:18.975Z]                 section = cfg_section[sno]
[2026-08-04T23:06:18.975Z]                 # The ini routines simply append a config item immediately
[2026-08-04T23:06:18.975Z]                 # after the section header. To keep the same order as defined
[2026-08-04T23:06:18.975Z]                 # in local.conf, invoke the ini routines in the reverse order
[2026-08-04T23:06:18.975Z]                 for (attr_no = cfg_sec_attr_count[sno] - 1; attr_no >=0; attr_no--) {
[2026-08-04T23:06:18.975Z]                     attr = cfg_sec_attr_name[sno, attr_no]
[2026-08-04T23:06:18.975Z]                     if (cfg_attr_count[section, attr] == 1)
[2026-08-04T23:06:18.975Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, 0] "\""
[2026-08-04T23:06:18.975Z]                     else {
[2026-08-04T23:06:18.975Z]                         # For multiline, invoke the ini routines in the reverse order
[2026-08-04T23:06:18.975Z]                         count = cfg_attr_count[section, attr]
[2026-08-04T23:06:18.975Z]                         print "inidelete " configfile " " section " " attr
[2026-08-04T23:06:18.975Z]                         print "iniset " configfile " " section " " attr " \"" cfg_attr[section, attr, count - 1] "\""
[2026-08-04T23:06:18.976Z]                         for (l = count -2; l >= 0; l--)
[2026-08-04T23:06:18.976Z]                             print "iniadd_literal " configfile " " section " " attr " \"" cfg_attr[section, attr, l] "\""
[2026-08-04T23:06:18.976Z]                     }
[2026-08-04T23:06:18.976Z]                 }
[2026-08-04T23:06:18.976Z]             }
[2026-08-04T23:06:18.976Z]         }
[2026-08-04T23:06:18.976Z]     '

[2026-07-28T16:47:25.073Z]         /^[^ \t]+/ {
[2026-07-28T16:47:25.073Z]             # get offset of first = in $0
[2026-07-28T16:47:25.073Z]             eq_idx = index($0, "=")
[2026-07-28T16:47:25.073Z]             # extract attr & value from $0
[2026-07-28T16:47:25.073Z]             attr = substr($0, 1, eq_idx - 1)
[2026-07-28T16:47:25.073Z]             value = substr($0, eq_idx + 1)
[2026-07-28T16:47:25.073Z]             # only need to strip trailing whitespace from attr
[2026-07-28T16:47:25.073Z]             sub(/[ \t]*$/, "", attr)
[2026-07-28T16:47:25.073Z]             # need to strip leading & trailing whitespace from value
[2026-07-28T16:47:25.073Z]             sub(/^[ \t]*/, "", value)

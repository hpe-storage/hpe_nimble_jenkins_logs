[2026-07-27T14:49:57.860Z]         }
[2026-07-27T14:49:57.860Z]         /^[^ \t]+/ {
[2026-07-27T14:49:57.860Z]             # get offset of first = in $0
[2026-07-27T14:49:57.860Z]             eq_idx = index($0, "=")
[2026-07-27T14:49:57.860Z]             # extract attr & value from $0
[2026-07-27T14:49:57.861Z]             attr = substr($0, 1, eq_idx - 1)
[2026-07-27T14:49:57.861Z]             value = substr($0, eq_idx + 1)
[2026-07-27T14:49:57.861Z]             # only need to strip trailing whitespace from attr
[2026-07-27T14:49:57.861Z]             sub(/[ \t]*$/, "", attr)
[2026-07-27T14:49:57.861Z]             # need to strip leading & trailing whitespace from value
[2026-07-27T14:49:57.861Z]             sub(/^[ \t]*/, "", value)
[2026-07-27T14:49:57.861Z]             sub(/[ \t]*$/, "", value)

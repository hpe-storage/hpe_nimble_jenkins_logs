[2026-07-28T17:32:14.031Z]         /^[^ \t]+/ {
[2026-07-28T17:32:14.031Z]             # get offset of first = in $0
[2026-07-28T17:32:14.031Z]             eq_idx = index($0, "=")
[2026-07-28T17:32:14.031Z]             # extract attr & value from $0
[2026-07-28T17:32:14.031Z]             attr = substr($0, 1, eq_idx - 1)
[2026-07-28T17:32:14.031Z]             value = substr($0, eq_idx + 1)
[2026-07-28T17:32:14.031Z]             # only need to strip trailing whitespace from attr
[2026-07-28T17:32:14.031Z]             sub(/[ \t]*$/, "", attr)
[2026-07-28T17:32:14.032Z]             # need to strip leading & trailing whitespace from value
[2026-07-28T17:32:14.032Z]             sub(/^[ \t]*/, "", value)
[2026-07-28T17:32:14.032Z]             sub(/[ \t]*$/, "", value)

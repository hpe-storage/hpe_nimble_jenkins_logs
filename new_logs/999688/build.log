[2026-08-04T07:20:47.182Z] 
[2026-08-04T07:20:47.182Z]                 cfg_attr[section, attr, 0] = value
[2026-08-04T07:20:47.182Z]                 cfg_attr_count[section, attr] = 1
[2026-08-04T07:20:47.182Z]             } else {
[2026-08-04T07:20:47.182Z]                 lno = cfg_attr_count[section, attr]++
[2026-08-04T07:20:47.182Z]                 cfg_attr[section, attr, lno] = value
[2026-08-04T07:20:47.182Z]             }

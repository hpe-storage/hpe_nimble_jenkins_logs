[2026-08-04T07:20:47.181Z]         }
[2026-08-04T07:20:47.181Z]         /^ *\#/ {
[2026-08-04T07:20:47.181Z]             next
[2026-08-04T07:20:47.181Z]         }
[2026-08-04T07:20:47.181Z]         /^[^ \t]+/ {
[2026-08-04T07:20:47.181Z]             # get offset of first = in $0
[2026-08-04T07:20:47.181Z]             eq_idx = index($0, "=")
[2026-08-04T07:20:47.181Z]             # extract attr & value from $0
[2026-08-04T07:20:47.181Z]             attr = substr($0, 1, eq_idx - 1)
[2026-08-04T07:20:47.181Z]             value = substr($0, eq_idx + 1)
[2026-08-04T07:20:47.181Z]             # only need to strip trailing whitespace from attr
[2026-08-04T07:20:47.181Z]             sub(/[ \t]*$/, "", attr)
[2026-08-04T07:20:47.181Z]             # need to strip leading & trailing whitespace from value
[2026-08-04T07:20:47.181Z]             sub(/^[ \t]*/, "", value)
[2026-08-04T07:20:47.181Z]             sub(/[ \t]*$/, "", value)
[2026-08-04T07:20:47.181Z] 
[2026-08-04T07:20:47.182Z]             # cfg_attr_count: number of config lines per [section, attr]
[2026-08-04T07:20:47.182Z]             # cfg_attr: three dimensional array to keep all the config lines per [section, attr]
[2026-08-04T07:20:47.182Z]             # cfg_section: keep the section names in the same order as they appear in local.conf
[2026-08-04T07:20:47.182Z]             # cfg_sec_attr_name: keep the attr names in the same order as they appear in local.conf
[2026-08-04T07:20:47.182Z]             if (! (section, attr) in cfg_attr_count) {
[2026-08-04T07:20:47.182Z]                 if (section != last_section) {

[2026-07-27T11:13:09.381Z]         /^[^ \t]+/ {
[2026-07-27T11:13:09.381Z]             # get offset of first = in $0
[2026-07-27T11:13:09.381Z]             eq_idx = index($0, "=")
[2026-07-27T11:13:09.381Z]             # extract attr & value from $0
[2026-07-27T11:13:09.381Z]             attr = substr($0, 1, eq_idx - 1)
[2026-07-27T11:13:09.381Z]             value = substr($0, eq_idx + 1)
[2026-07-27T11:13:09.381Z]             # only need to strip trailing whitespace from attr
[2026-07-27T11:13:09.381Z]             sub(/[ \t]*$/, "", attr)
[2026-07-27T11:13:09.381Z]             # need to strip leading & trailing whitespace from value
